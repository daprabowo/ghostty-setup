# --- Themes ---
theme = light:Gruvbox Light,dark:Gruvbox Dark Hard

# --- Background ---
background-opacity = 0.85
background-blur = true
# background-image = ~/.config/ghostty/images/L6G1Ips-dark.png
# background-image-opacity = 0.25
# background-image-fit = stretch

# --- App Icon ---
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/icons/gruvbox-dark-hard.icns

# --- Cursor ---
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

